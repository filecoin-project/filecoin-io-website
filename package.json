{
  "name": "filecoin-io-website",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.3",
  "engines": {
    "npm": ">=10.9.0",
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint:md": "markdownlint-cli2 \"apps/**/*.md\" \"!**/node_modules/**\" --config .markdownlint.jsonc",
    "check:versions": "syncpack lint",
    "fix:versions": "syncpack fix",
    "prepare": "test \"$CI\" = \"true\" || husky"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.7"
  },
  "dependencies": {
    "@percy/cli": "^1.32.11"
  },
  "overrides": {
    "dompurify": "^3.3.0",
    "jsonpath-plus": "^10.3.0"
  }
}
