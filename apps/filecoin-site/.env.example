# TinaCMS (Tina Cloud) — required for `tinacms build` and the /admin UI
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Sentry — DSN is public; auth token is used at build time for sourcemap upload
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN_FILECOIN_SITE=

# Mailchimp newsletter (POST /api/mailchimp)
MAILCHIMP_U=
MAILCHIMP_LIST_ID=

# HubSpot form (POST /api/hubspot/store-data, behind /store-data/talk-to-expert)
HUBSPOT_PORTAL_ID=
HUBSPOT_STORE_DATA_FORM_ID=

# Google Sheets behind the contact form (POST /api/contact) and the storage provider form
# (POST /api/provider): the web app URL of the Apps Script in scripts/contact-sheet/Code.gs,
# one sheet per form. Unset, development logs submissions; production answers 503.
CONTACT_SHEET_WEBHOOK_URL=
PROVIDER_SHEET_WEBHOOK_URL=
PARTNER_SHEET_WEBHOOK_URL=

# Provided automatically by Vercel — used by tina/config.ts for branch detection
# VERCEL_GIT_COMMIT_REF=
